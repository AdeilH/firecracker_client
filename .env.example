# Template for .env — copy to .env and fill in. Only `firecracker-broker ui`
# loads it; real environment variables win over this file.

# --- broker host ---
MICROVMS_URL=http://192.168.0.118:8420
MICROVMS_TOKEN=

# --- agent LLM: any OpenAI-compatible chat API ---
# Hosted OpenAI: fill the key, leave the base URL commented.
# Local server (Ollama/LM Studio/vLLM): set OPENAI_BASE_URL instead; no key needed.
OPENAI_API_KEY=
#OPENAI_BASE_URL=http://localhost:11434/v1
#OPENAI_MODEL=gpt-4o-mini
